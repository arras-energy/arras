#define CASE=14

// #set debug=TRUE
#set suppress_repeat_messages=FALSE

module pypower
{
    maximum_timestep 3600;
    save_case TRUE;
}

#include "case.glm"

modify pp_bus_2.latitude 38.5;
modify pp_bus_2.longitude -122.5;

object pypower.load
{
    name "load_2";    
    parent "pp_bus_2";
    latitude 38.5;
    longitude -122.5;
    Vn 12.5 kV;
    status ONLINE;
}

object pypower.geodata
{
    file "test_case14_geodata_P.csv";
    target "load_2.P";
}

module tape
{
    csv_header_type NAME;
}

object tape.recorder
{
    parent "load_2";
    file "test_case14_geodata_load_2_record.csv";
    property "P";
}

// gridlabd compares test_case14_geodata_load_2_record.csv with its output (the tests do)
