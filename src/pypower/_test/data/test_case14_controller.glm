#define CASE=14

module pypower
{
    controllers "controllers";
}

object pypower.load
{
    parent pp_bus_2;
    Vn 12.5 kV;
    status ONLINE;
    controller "load_control";
}

object pypower.powerplant
{
    parent pp_bus_2;
    status ONLINE;
    controller "powerplant_control";
}

object pypower.relay
{
    parent pp_branch_1;
    status CLOSED;
    controller "relay_control";
}

object pypower.scada
{
    point pp_bus_3.Va;
    point pp_bus_4.Va;
    record TRUE;
}

#include "case.glm"

clock
{
    timezone "America/Los_Angeles";
    starttime "2020-01-01 00:00:00";
    stoptime "2020-01-02 00:00:00";
}

