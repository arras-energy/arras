module tape
{
	csv_header_type NAME;
}

#set suppress_repeat_messages=FALSE
object multi_recorder
{
	file "test_case14_ts.csv";
// gridlabd: #for N in ${RANGE 1,14} ... #done
	property "pp_bus_1:Pd,pp_bus_1:Qd";
	property "pp_bus_2:Pd,pp_bus_2:Qd";
	property "pp_bus_3:Pd,pp_bus_3:Qd";
	property "pp_bus_4:Pd,pp_bus_4:Qd";
	property "pp_bus_5:Pd,pp_bus_5:Qd";
	property "pp_bus_6:Pd,pp_bus_6:Qd";
	property "pp_bus_7:Pd,pp_bus_7:Qd";
	property "pp_bus_8:Pd,pp_bus_8:Qd";
	property "pp_bus_9:Pd,pp_bus_9:Qd";
	property "pp_bus_10:Pd,pp_bus_10:Qd";
	property "pp_bus_11:Pd,pp_bus_11:Qd";
	property "pp_bus_12:Pd,pp_bus_12:Qd";
	property "pp_bus_13:Pd,pp_bus_13:Qd";
	property "pp_bus_14:Pd,pp_bus_14:Qd";
	interval -1;
}

clock
{
    timezone "America/Los_Angeles";
    starttime "2020-01-01 00:00:00";
    stoptime "2020-01-02 00:00:00";
}

module assert;
#define MRES=0.05 // magnitude test resolution
#define ARES=0.2 // angle test resolution

object assert
{
    parent pp_bus_1;
    target Vm;
    relation ==;
    value 1.060;
    within ${MRES};
}
object assert
{
    parent pp_bus_1;
    target Va;
    relation ==;
    value 0.00;
    within ${ARES};
}

