// Adapted from arras-energy/gridlabd module/residential/autotest/test_HVAC_peak_cool.glm (076e78a):
// - timezone Etc/GMT-1 (PST+0PDT is not an arras timezone; the run is in daylight time, UTC+1)
// - the constant setpoint schedules are constant setpoints
// - the zippwr schedule is the player test_HVAC_peak_cool_zippwr.csv
// - the 1 s recorders record every 5 min (the results are the same with 60 s steps)
// - the tests read WA-Yakima_Air_Terminal.tmy3 from src/climate/_test/data
// - the meter is fed by a swing triplex_node through a 0.1 ft lossless triplex_line (arras meters measure the links that feed them)
//This will test the accuracy of the HVAC energy use and temperature behavior
//This test is an example of a peak cooling day
//test_HVAC_peak_cool.glm created by Andy Fisher
#set minimum_timestep=1;

module residential{
	implicit_enduses NONE;
}
module tape;
module assert;
module climate;
module powerflow;

clock{
	timezone "Etc/GMT-1";
	starttime '2001-07-22 01:00:00';
	stoptime '2001-07-23 01:00:36';
}



object climate
{
	tmyfile "WA-Yakima_Air_Terminal.tmy3";
}

object triplex_node {
	name source;
	phases AS;
	nominal_voltage 120;
	bustype SWING;
}
object triplex_line_conductor {
	name tlc;
	resistance 1e-9;
	geometric_mean_radius 0.0111;
}
object triplex_line_configuration {
	name tlcfg;
	conductor_1 tlc;
	conductor_2 tlc;
	conductor_N tlc;
	insulation_thickness 0.08;
	diameter 0.368;
}
object triplex_line {
	phases AS;
	from source;
	to meter;
	length 0.1;
	configuration tlcfg;
}
object triplex_meter{
	name meter;
	nominal_voltage 120;
	phases AS;
	object house{
		window_wall_ratio 0.07;
		cooling_COP 3.0;
		system_mode OFF;
		auxiliary_strategy DEADBAND;
		heating_system_type HEAT_PUMP;
		cooling_system_type ELECTRIC;
		air_temperature 66.0;
		mass_temperature 66.0;
		heating_setpoint 60;
		cooling_setpoint 75;
		object recorder{
			property energy,panel.energy;
			file "test_HVAC_peak_cool.csv";
			interval 300;
		};
		object recorder{
			property energy,panel.energy;
			file "test_HVAC_peak_cool_hourly.csv";
			interval 3600;
		};
		object complex_assert{
			target "energy";
			in '2001-07-23 1:00:34';
			once ONCE_TRUE;
			value 21.5043+0i;
			within 0.10911;//asserting house_e within 0.5 percent of Rob's ETP result
		};
		object ZIPload {
			heat_fraction 1;
			object player {
				property base_power;
				file "test_HVAC_peak_cool_zippwr.csv";
			};		
			power_pf 1;
			power_fraction 1;
			current_pf 0;
			current_fraction 0;
			impedance_pf 0;
			impedance_fraction 0;
		};
	};
	object recorder{
		property measured_real_energy;
		file "test_HVAC_peak_cool_energy.csv";
		interval 300;
	};
	object double_assert{
		target "measured_real_energy";
		in '2001-07-23 1:00:34';
		once ONCE_TRUE;
		value 38505;
		within 194.11;//asserting house_e within 0.5 percent of Rob's ETP result
	};
}
