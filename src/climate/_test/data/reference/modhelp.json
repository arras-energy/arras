                "type": "enumeration",
                "access": "PUBLIC",
                "keywords": {
                    "CUMULUS": "0x1",
                    "NONE": "0x0"
                },
                "flags": "OUTPUT",
                "default": "NONE",
                "description": "the cloud model to use"
            },
            "cloud_opacity": {
                "type": "double",
                "access": "PUBLIC",
                "flags": "OUTPUT",
