// Testing Four Quadrant Inverter Modes:
//		 		Constant PF & Constant PQ mode 
//				(w/ fixed solar orientation and single-point efficiency)

// #set profiler=1
// #set threadcount=1;
#set relax_naming_rules=1
//#set pauseatexit=1;
module powerflow;
module generators;
module tape;
module climate;
module assert;
module powerflow{
	solver_method NR;
	default_maximum_voltage_error 1e-9;
}

clock {
	timezone "America/Los_Angeles";
	starttime '2010-06-01 0:00:00';
	stoptime '2010-06-02 1:00:00';
}




object climate
{
	name MyClimate;
	tmyfile "WA-Yakima_Air_Terminal.tmy3";
	object recorder {
		file climate_out.csv;
		interval 3600;
		limit 25;
		property temperature,solar_global,solar_direct;
	};
}

object transformer_configuration {
	name trans_config_to_feeder;
	connect_type WYE_WYE;
	install_type PADMOUNT;
	primary_voltage 33000;
	secondary_voltage 2401.777;
	power_rating 5 MVA;
	impedance 0.00033+0.0022j;
}
object transformer_configuration {
		name inv_transformer;
		connect_type SINGLE_PHASE_CENTER_TAPPED;
		install_type POLETOP;
		shunt_impedance 10000+10000j;
		primary_voltage 2401.777;
		secondary_voltage 120;
		powerB_rating 110 kVA;
		impedance 0.00033+0.0022j;
	};

object node {
	name network_node;
	bustype SWING;
	nominal_voltage 33000;
	phases ABCN;
}

object transformer {
	name substation_transformer;
	from network_node;
	to 645;
	phases ABCN;
	configuration trans_config_to_feeder;
}; 

object node {     
	name 645;     
	phases ABCN;     
	voltage_A 2401.7771;     
	voltage_B -1200.8886-2080.000j;     
	voltage_C -1200.8886+2080.000j;     
	nominal_voltage 2401.7771;
}

object link {
	name const_pq_link;
	from 645;
	to const_pq_meter;
	phases ABCN;
}

object meter {
		name const_pq_meter;
		phases ABCN;
		voltage_A 2401.7771;     
		voltage_B -1200.8886-2080.000j;     
		voltage_C -1200.8886+2080.000j;     
		nominal_voltage 2401.7771;
		// object recorder {
			// property measured_power,measured_power_A,measured_power_B,measured_power_C;
			// file const_pq_meter.csv;
			// interval 3600;
		// };
		object complex_assert {
			target measured_power;
			object player {
				property value;
				//file "constantPQmeterPower_static_efficiency.player";
				file "constantPQmeterPower_static_efficiency.player";
			};
			within "0.1";
		};	
		object inverter {
			name const_pq_inv;
			inverter_type FOUR_QUADRANT;
			use_multipoint_efficiency FALSE;
			four_quadrant_control_mode CONSTANT_PQ;
			rated_power 1340;
			object player { property P_Out; file "test_4quad_inv_modes_PF_PQ_default_efficiency_output_power.player"; };
			object player { property Q_Out; file "test_4quad_inv_modes_PF_PQ_default_efficiency_output_var.player"; };
			V_In 266+0j;
			I_In 15.1203+0j;
			// object recorder {
				// property V_In,I_In,VA_In,VA_Out;
				// file const_pq_inv.csv;
				// interval 3600;
				// limit 25;
			// };
		};
	};


object transformer {
	name CTTF_B_645;
	phases BS;
	from 645;
	to tn_B_645;
	configuration inv_transformer;
}

object triplex_meter { 
	name tn_B_645;
	phases BS;
	nominal_voltage 120;
	groupid House_Meter;
	// object recorder {
		// property measured_real_power,measured_reactive_power,constant_constant_power_12;
		// file const_pf_meter.csv;
		// interval 3600;
	// };
	object complex_assert {
		target measured_power;
		object player {
			property value;
			//file "constantPFmeterPower_static_efficiency.player";
			file "constantPFmeterPower_static_efficiency.player";
		};
		within "0.1";
	};
	object inverter {
		name const_pf_inv;
		phases BS;
		inverter_type FOUR_QUADRANT;
		object player { property power_factor; file "test_4quad_inv_modes_PF_PQ_default_efficiency_pf_sched.player"; };
		use_multipoint_efficiency FALSE;
		four_quadrant_control_mode CONSTANT_PF;
		V_In 266+0j;
		I_In 15.1203+0j;
		// object recorder {
			// property V_In,I_In,VA_In,VA_Out;
			// file const_pf_inv.csv;
			// interval 3600;
			// limit 25;
		// };
	};
}

	

	    
	
