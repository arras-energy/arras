            "day": {
                "type": "int16",
                "access": "PUBLIC",
                "flags": "OUTPUT",
                "description": "current day"
            },
            "hour": {
                "type": "int16",
                "access": "PUBLIC",
                "flags": "OUTPUT",
                "description": "current hour"
            },
            "minute": {
                "type": "int16",
                "access": "PUBLIC",
                "flags": "OUTPUT",
